[Unit]
Description=AI channel windows at 08:20, 16:20 and 23:20 Beijing time

[Timer]
OnCalendar=*-*-* 08:20:00 Asia/Shanghai
OnCalendar=*-*-* 16:20:00 Asia/Shanghai
OnCalendar=*-*-* 23:20:00 Asia/Shanghai
Persistent=false
AccuracySec=1s
Unit=telegram-channel-matrix.service

[Install]
WantedBy=timers.target
